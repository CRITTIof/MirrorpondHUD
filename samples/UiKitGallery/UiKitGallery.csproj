<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <AssemblyName>UiKitGallery</AssemblyName>
    <RootNamespace>UiKitGallery</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Version>0.1.0</Version>
    <Product>UiKit 控件画廊示例插件</Product>
    <AssemblyTitle>UiKitGallery</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contracts / UiKit 由宿主在运行时提供，插件输出目录不再重复带一份（Private=false）。 -->
    <ProjectReference Include="..\..\src\Contracts\MirrorpondHUD.Contracts.csproj" Private="false" />
    <ProjectReference Include="..\..\src\UiKit\MirrorpondHUD.UiKit.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 把 manifest 一并复制到输出目录，README 的安装步骤可以直接从 bin\Release 复制。 -->
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
