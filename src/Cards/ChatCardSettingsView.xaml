<UserControl x:Class="MirrorpondHUD.Cards.ChatCardSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="AI 接口" Style="{StaticResource SectionTitle}" Margin="0,6,0,6" />

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="接口地址" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding ChatBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="OpenAI 兼容接口的根地址，末尾不用写 /chat/completions。&#x0a;例如 https://api.openai.com/v1 、https://api.deepseek.com/v1 、http://127.0.0.1:11434/v1" />
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="模型" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="写进请求的 model 字段，也是卡片第一行显示的名字" />
            <TextBlock Grid.Column="2" Text="显示在卡片第一行" Margin="8,0,0,0"
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                       FontSize="12" />
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="API Key" VerticalAlignment="Center" />
            <Grid Grid.Column="1">
                <TextBox Text="{Binding ChatApiKey, UpdateSourceTrigger=PropertyChanged}"
                         LostKeyboardFocus="ChatApiKeyBoxLostFocus"
                         ToolTip="按 Windows DPAPI 加密后存进 settings.json（只有当前用户能解）；这里不会回显已存的 Key&#x0a;本地服务（LM Studio / Ollama 兼容层）可以留空" />
                <TextBlock Text="{Binding ChatApiKeyPlaceholder}"
                           Visibility="{Binding ChatApiKeyPlaceholderVisibility}"
                           Margin="9,0,6,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondary}" />
            </Grid>
            <Button Grid.Column="2" Content="清除" Margin="6,0,0,0" Padding="10,2"
                    Click="ClearChatApiKeyClick"
                    Visibility="{Binding ChatApiKeyClearVisibility}"
                    ToolTip="删掉已存的 Key（settings.json 里的密文也一起清掉）" />
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="模式" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                      SelectedIndex="{Binding ChatModeIndex}"
                      ToolTip="单次：每次提问都不带历史&#x0a;轮询：保留上下文，把之前的问答一起发回去&#x0a;卡片上不再放按钮，切换走「热键」页里的「AI 对话：切换单次 / 轮询」">
                <ComboBoxItem Content="单次（不带历史）" />
                <ComboBoxItem Content="轮询（连续对话）" />
            </ComboBox>
            <TextBlock Grid.Column="2" Text="超时" VerticalAlignment="Center" Margin="18,0,6,0" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Width="56" VerticalAlignment="Center"
                         Text="{Binding ChatTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="秒" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="系统提示" VerticalAlignment="Top" Margin="0,6,0,0" />
            <TextBox Grid.Column="1" Height="58" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="{Binding ChatSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="可选：每条对话开头都发这一段，用来设定语气 / 角色" />
        </Grid>

        <TextBlock Text="{Binding ChatHint}" Margin="0,0,0,2"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondary}"
                   ToolTip="{Binding ChatHint}" />

        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                   Text="请求走 POST {接口地址}/chat/completions（OpenAI 兼容）。卡片是命令行样式：第一行模型名，第二行 › 之后打字，回车发送；单次 / 轮询与清空上下文都在「热键」页（默认 Ctrl+Alt+Shift+M 切换模式）。这张卡需要输入框，所以不点击穿透：点一下卡片就能打字，代价是它会挡住身下的桌面点击。" />
    </StackPanel>
</UserControl>
