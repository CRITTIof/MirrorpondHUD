    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>MirrorpondHUD.UiKit</AssemblyName>
    <RootNamespace>MirrorpondHUD</RootNamespace>
    <Version>2.36.0</Version>
    <Product>镜潭一览 (MirrorpondHUD) UiKit</Product>
    <AssemblyTitle>MirrorpondHUD.UiKit</AssemblyTitle>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\MirrorpondHUD.Contracts.csproj" />
  </ItemGroup>

</Project>
