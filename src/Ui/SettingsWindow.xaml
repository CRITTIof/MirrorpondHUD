                                <Slider x:Name="LoopDurationSlider" Width="260" Minimum="600" Maximum="10000" />
                                <TextBox x:Name="LoopDurationValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PulseThicknessRow" Margin="0,0,0,10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="脉冲粗细" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="PulseThicknessSlider" Width="260" Minimum="1" Maximum="8"
                                        IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBox x:Name="PulseThicknessValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                                <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ScanlineThicknessRow" Margin="0,0,0,10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="扫描线粗细" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="ScanlineThicknessSlider" Width="260" Minimum="1" Maximum="10"
                                        IsSnapToTickEnabled="True" TickFrequency="1" />
                                <TextBox x:Name="ScanlineThicknessValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                                <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="LoopAmplitudeRow" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="呼吸幅度" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="LoopAmplitudeSlider" Width="260" Minimum="0.02" Maximum="0.8" />
                                <TextBox x:Name="LoopAmplitudeValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ContourSpeedRow" Margin="0,0,0,10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="变化速度" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="ContourSpeedSlider" Width="260" Minimum="0.1" Maximum="4.0" />
                                <TextBox x:Name="ContourSpeedValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                                <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Text="1.0 = 10 秒一个形变周期" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="110,0,0,10"
                                   Text="循环效果持续占用 GPU；等高线约 30fps 重算几何。减少动效开启时自动停。" />

                        <StackPanel x:Name="IntroOptionsPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="欢迎语" VerticalAlignment="Center" />
                                <TextBox x:Name="WelcomeBox" Width="220" Margin="8,0,16,0" />
                                <TextBlock Text="速度" VerticalAlignment="Center" />
                                <TextBox x:Name="TypeSpeedBox" Width="64" Margin="8,0,0,0" />
                                <TextBlock Text="毫秒 / 字" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="光标样式" VerticalAlignment="Center" />
                                <ComboBox x:Name="CursorStyleCombo" Width="140" Margin="8,0,20,0">
                                    <ComboBoxItem Content="不显示" Tag="None" />
                                    <ComboBoxItem Content="方块" Tag="Block" />
                                    <ComboBoxItem Content="竖线" Tag="Bar" />
                                    <ComboBoxItem Content="下划线" Tag="Underline" />
                                    <ComboBoxItem Content="空心框" Tag="Outline" />
                                </ComboBox>
                                <CheckBox x:Name="CursorBlinkCheck" Content="光标闪烁" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="打字时显示模拟光标，启动动画只播放第一张可见卡片。" />
                        </StackPanel>

                        <TextBlock Text="终末地视觉" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="M2–M8 可分别关闭；关闭后回到旧样式，默认全开。" />

                        <WrapPanel Margin="110,0,0,8">
                            <CheckBox x:Name="EndfieldShadowCheck" Content="环境阴影" Margin="0,0,18,8"
                                      ToolTip="M2：零偏移的四周均匀阴影；关闭后回到从上方打光的投影。" />
                            <CheckBox x:Name="EndfieldSelectionCheck" Content="选中左条" Margin="0,0,18,8"
                                      ToolTip="M3：列表左缘 2px；大/中图标下缘 3px；关闭后只保留强调色淡底。" />
                            <CheckBox x:Name="EndfieldButtonCheck" Content="工业按钮" Margin="0,0,18,8"
                                      ToolTip="M4：实心主行动、深色次行动、4px 微圆角；关闭后回到描边按钮。" />
                            <CheckBox x:Name="EndfieldSegmentCheck" Content="分段进度" Margin="0,0,18,8"
                                      ToolTip="M5：28 段直角进度块；关闭后回到 3px 半圆端头。" />
                            <CheckBox x:Name="EndfieldMetaCheck" Content="编号与页脚" Margin="0,0,18,8"
                                      ToolTip="M6：卡片编号 / 页脚；信息与文本卡始终不显示。" />
                            <CheckBox x:Name="EndfieldBracketCheck" Content="角括号" Margin="0,0,18,8"
                                      ToolTip="M7：错误 / 警告状态的角括号，以及媒体异常时的四角记号。" />
                            <CheckBox x:Name="EndfieldCutCheck" Content="切角" Margin="0,0,18,8"
                                      ToolTip="M8：主行动按钮与角标的 45° 切角；关闭后保留圆角矩形。" />
                        </WrapPanel>

                        <Grid x:Name="FooterTextBoxRow" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="页脚内容" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBox x:Name="FooterTextBox" Width="360" HorizontalAlignment="Left"
                                         ToolTip="空 = 默认 v{version} · MON {monitor}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="占位符：{version} 版本、{monitor} 显示器序号、{code} 卡片编号、{name} 卡片名。" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="高级" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />

                        <CheckBox x:Name="AcrylicCheck" Content="毛玻璃背景" Margin="0,0,0,4" />

                        <StackPanel x:Name="GlassOptionsPanel" Visibility="Collapsed">
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="玻璃实现" VerticalAlignment="Center" />
                            <ComboBox x:Name="GlassModeCombo" Grid.Column="1" Width="300" HorizontalAlignment="Left">
                                <ComboBoxItem Content="系统亚克力" Tag="System" ToolTip="accent 底板，不抓屏" />
                                <ComboBoxItem Content="桌面取样" Tag="DesktopFeed" ToolTip="截屏 + 模糊，卡片不进截图" />
                                <ComboBoxItem Content="兼容" Tag="Compat" ToolTip="截屏取样，CPU 模糊" />
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="AcrylicHint" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"
                                   Text="由 DWM 在卡片下面画实时亚克力。模糊在 GPU 上完成，进程侧不抓屏；模糊强度与刷新帧率由系统决定。关闭系统透明效果或远程桌面时自动退回兼容实现。"
                                   TextWrapping="Wrap" />

                        <Grid x:Name="GlassBlurRow" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模糊强度" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="GlassBlurSlider" Width="260" Minimum="0" Maximum="60" />
                                <TextBox x:Name="GlassBlurValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                                <TextBlock Text="像素" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="GlassFpsRow" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="刷新帧率" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="GlassFpsSlider" Width="260" Minimum="2" Maximum="30" />
                                <TextBox x:Name="GlassFpsValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                                <TextBlock Text="帧/秒" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="GlassFpsHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="110,0,0,12"
                                   Text="每秒取屏并模糊；桌面静止时可降到 5 帧省电。" />

                        <Grid x:Name="GlassSourceRow" Margin="0,12,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="取图方式" VerticalAlignment="Center" />
                            <ComboBox x:Name="GlassSourceCombo" Grid.Column="1" Width="300" HorizontalAlignment="Left">
                                <ComboBoxItem Content="自动" Tag="Auto" ToolTip="能拿到桌面复制就用" />
                                <ComboBoxItem Content="GPU 加速" Tag="Gpu" ToolTip="DXGI 桌面复制" />
                                <ComboBoxItem Content="CPU 读屏" Tag="Cpu" ToolTip="GDI，兼容性最好" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="GlassSourceHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="110,0,0,10"
                                   Text="只有「桌面取样」自己抓屏，所以这一项只对它生效。" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 数据源 ==================== -->
            <TabItem Header="数据源" Tag="&#xE0AD;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16,18,24">

                        <TextBlock Text="刷新" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="采样间隔" VerticalAlignment="Center" />
                            <ComboBox x:Name="RefreshCombo" Width="140" Margin="8,0,0,0" />
                            <TextBlock Text="间隔越短越流畅，CPU 占用略高" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="设备数据" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox x:Name="CpuCheck" Content="CPU" Margin="0,0,24,10" />
                            <CheckBox x:Name="GpuCheck" Content="GPU" Margin="0,0,24,10" />
                            <CheckBox x:Name="MemCheck" Content="内存" Margin="0,0,24,10" />
                            <CheckBox x:Name="DiskCheck" Content="磁盘" Margin="0,0,24,10" />
                            <CheckBox x:Name="NetCheck" Content="网络" Margin="0,0,24,10" />
                        </WrapPanel>

                        <StackPanel x:Name="GpuOptionsPanel">
                            <TextBlock Text="GPU 选择" Style="{StaticResource SectionTitle}" Margin="0,10,0,6" />
                            <ComboBox x:Name="GpuCombo" Width="260" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel x:Name="DrivesOptionsPanel">
                            <TextBlock Text="磁盘分区" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="用于统计剩余空间。" />
                            <WrapPanel x:Name="DrivesPanel" />
                        </StackPanel>

                        <StackPanel x:Name="NetworkOptionsPanel">
                            <TextBlock Text="网卡" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="AdapterCombo" Width="380" />
                                <Button Content="刷新" Margin="8,0,0,0" Click="RefreshAdaptersClick" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="键盘输入" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                        <CheckBox x:Name="KeysCheck" Content="记录按键" Margin="0,0,0,10" />
                        <StackPanel x:Name="KeyboardOptionsPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="显示最近" VerticalAlignment="Center" />
                                <TextBox x:Name="KeyCountBox" Width="60" Margin="8,0,8,0" />
                                <TextBlock Text="个按键      连续重复超过" VerticalAlignment="Center" />
                                <TextBox x:Name="RepeatBox" Width="60" Margin="8,0,8,0" />
                                <TextBlock Text="次折叠为 字符×次数" VerticalAlignment="Center" />
                                <Button Content="清空记录" Margin="16,0,0,0" Click="ClearKeysClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="最多显示" VerticalAlignment="Center" />
                                <TextBox x:Name="MaxKeyCharsBox" Width="60" Margin="8,0,8,0" />
                                <TextBlock Text="个字符" VerticalAlignment="Center" />
                                <TextBlock Text="空格和分隔符也计入，默认 18" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="NVIDIA 显卡" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="温度、显存与功耗。" />
                        <CheckBox x:Name="NvidiaCheck" Content="启用 nvidia-smi 数据" Margin="0,0,0,10" />
                        <StackPanel x:Name="NvidiaOptionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="采样间隔" VerticalAlignment="Center" />
                            <ComboBox x:Name="NvidiaIntervalCombo" Width="120" Margin="8,0,0,0" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 行为 ==================== -->
            <TabItem Header="行为" Tag="&#xE29A;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16,18,24">

                        <TextBlock Text="窗口" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <CheckBox x:Name="TopmostCheck" Content="始终置顶" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="叠层拖动只由 F8 或托盘菜单的锁定切换，开关本窗口不会自动锁定。" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="锚点" VerticalAlignment="Center" />
                            <ComboBox x:Name="MonitorCombo" Width="180" Margin="8,0,16,0" />
                            <TextBlock Text="X" VerticalAlignment="Center" />
                            <TextBox x:Name="XBox" Width="70" Margin="8,0,16,0" />
                            <TextBlock Text="Y" VerticalAlignment="Center" />
                            <TextBox x:Name="YBox" Width="70" Margin="8,0,16,0" />
                            <Button Content="应用位置" Click="ApplyPositionClick" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="第一张卡片对齐锚点，其余按间距向下排列。解锁后拖动任意卡片可移动整叠，松手保存。" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="固定宽度" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="FixedWidthSlider" Width="260" Minimum="0" Maximum="1600" />
                                <TextBox x:Name="FixedWidthValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="110,2,0,0" TextWrapping="Wrap"
                                   Text="0 = 自适应，宽度只增不减，信息位置不会来回跳动。填数值可完全固定。" />

                        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,0,0,8" />
                        <CheckBox x:Name="StartMinCheck" Content="启动后最小化到托盘" Margin="0,0,0,8" />
                        <CheckBox x:Name="TrayCheck" Content="显示托盘图标" Margin="0,0,0,8" />

                        <TextBlock Text="诊断" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日志等级" VerticalAlignment="Center" />
                            <ComboBox x:Name="LogLevelCombo" Grid.Column="1" Width="180"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="调试" Tag="Debug" />
                                <ComboBoxItem Content="常规" Tag="Info" />
                                <ComboBoxItem Content="警告" Tag="Warn" />
                                <ComboBoxItem Content="错误" Tag="Error" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="110,4,0,0"
                                   Text="调试会记录取图、媒体、插件加载等详细过程；日常用常规，排查问题再临时调低。" />

                        <TextBlock Text="文件" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="配置文件：" VerticalAlignment="Center" />
                            <TextBlock x:Name="PathText" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="打开配置目录" Click="OpenConfigFolderClick" Margin="0,0,8,0" />
                            <Button Content="打开日志" Click="OpenLogClick" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 热键 ==================== -->
            <TabItem Header="热键" Tag="&#xE284;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16,18,24">
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="点击输入框后按组合键；Esc 或清空可取消。卡片呼出热键在内容页设置。" />

                    <TextBlock Text="全局" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="显示 / 隐藏全部" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox x:Name="HotkeyToggleBox" Grid.Column="1" IsReadOnly="True"
                                 PreviewKeyDown="HotkeyBoxPreviewKeyDown" Margin="0,0,0,10" />
                        <Button Grid.Column="2" Content="清空" Margin="8,0,0,10" Padding="10,2"
                                VerticalAlignment="Center" Click="ClearHotkeyBoxClick"
                                Tag="{Binding ElementName=HotkeyToggleBox}"
                                ToolTip="清除这个热键，留空表示不启用" />

                        <TextBlock Text="打开设置" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox x:Name="HotkeySettingsBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                 PreviewKeyDown="HotkeyBoxPreviewKeyDown" Margin="0,0,0,10" />
                        <Button Grid.Row="1" Grid.Column="2" Content="清空" Margin="8,0,0,10" Padding="10,2"
                                VerticalAlignment="Center" Click="ClearHotkeyBoxClick"
                                Tag="{Binding ElementName=HotkeySettingsBox}"
                                ToolTip="清除这个热键，留空表示不启用" />

                        <TextBlock Text="锁定 / 解锁" Grid.Row="2" VerticalAlignment="Center" />
                        <TextBox x:Name="HotkeyLockBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True"
                                 PreviewKeyDown="HotkeyBoxPreviewKeyDown" />
                        <Button Grid.Row="2" Grid.Column="2" Content="清空" Margin="8,0,0,0" Padding="10,2"
                                VerticalAlignment="Center" Click="ClearHotkeyBoxClick"
                                Tag="{Binding ElementName=HotkeyLockBox}"
                                ToolTip="清除这个热键，留空表示不启用" />
                    </Grid>

                    <!-- 卡片模块提供的通用热键：按卡片种类分组，组间有分割线 -->
                    <StackPanel x:Name="CardHotkeyPanel" />

                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,16,0,0" TextWrapping="Wrap"
                               Text="留空 = 不启用该热键。热键被其它程序占用时，程序会自动退到 Ctrl+Alt+原键 并记入日志。" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

            <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="24,0,24,22" IsHitTestVisible="True">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="恢复默认" Margin="0,0,8,0" Click="ResetClick" />
                    <Button Content="关闭" Margin="0,0,8,0" Click="CloseClick" />
                    <Button x:Name="SaveButton" Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="SaveClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
    </AdornerDecorator>
    </Border>
    </Grid>
</Window>
