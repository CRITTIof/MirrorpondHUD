<Window x:Class="MirrorpondHUD.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="镜潭一览 · 设置" Width="1120" Height="820" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="/assets/logo.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12,18,12">
            <StackPanel Orientation="Horizontal">
                <Image Source="/assets/logo.ico" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="镜潭一览 · 设置" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1">

            <!-- ==================== 内容（卡片管理） ==================== -->
            <TabItem Header="内容" Tag="&#xE300;">
                <Grid Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddCardButton" Click="AddCardClick" Padding="12,6"
                                    ToolTip="选择一种卡片添加到列表末尾">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE308;" FontFamily="{StaticResource ReiconFont}" FontSize="15"
                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="添加卡片" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="CardCountText" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE305;" FontFamily="{StaticResource ReiconFont}" FontSize="14"
                                       Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBox x:Name="SearchBox" Width="200" TextChanged="SearchBoxTextChanged"
                                     ToolTip="按卡片名称 / 类型筛选" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <ItemsControl x:Name="CardList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}"
                                                BorderBrush="{StaticResource BorderSoft}"
                                                BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <!-- 标题栏：图标 + 名称 + 常驻/热键摘要；右侧移动 / 删除 / 展开 -->
                                                <Border Background="#F8FAFC" BorderBrush="#EDF0F4" BorderThickness="0,0,0,1"
                                                        CornerRadius="{Binding HeaderCorner}" Padding="12,7"
                                                        MouseLeftButtonDown="CardHeaderClick">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}"
                                                                       FontFamily="{StaticResource ReiconFont}"
                                                                       FontSize="16" Foreground="{StaticResource Accent}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <Border Background="#EEF2F7" CornerRadius="9" Padding="8,1"
                                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                                           Foreground="{StaticResource TextSecondary}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                                    Click="MoveCardClick" ToolTip="调整显示顺序">
                                                                <TextBlock Text="&#xE307;"
                                                                           FontFamily="{StaticResource ReiconFont}"
                                                                           FontSize="14" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                                    Click="DeleteCardClick" ToolTip="删除这张卡片">
                                                                <TextBlock Text="&#xE306;"
                                                                           FontFamily="{StaticResource ReiconFont}"
                                                                           FontSize="14" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                                    Click="ToggleCardClick" ToolTip="展开 / 折叠">
                                                                <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource TextSecondary}"
                                                                      StrokeThickness="1.6" VerticalAlignment="Center">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform Angle="{Binding ChevronAngle}"
                                                                                         CenterX="5" CenterY="3" />
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 设置项 -->
                                                <StackPanel Visibility="{Binding BodyVisibility}" Margin="14,10,14,14">
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="名称" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Margin="0,0,20,0"
                                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <CheckBox Grid.Column="2" Content="常驻"
                                                                  IsChecked="{Binding Resident}"
                                                                  IsEnabled="{Binding ResidentEnabled}"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="常驻：叠层显示时一直在屏幕上；关闭后需要用呼出热键打开" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="呼出热键" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Width="150" HorizontalAlignment="Left"
                                                                 Text="{Binding Hotkey, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 IsEnabled="{Binding HotkeyEnabled}"
                                                                 ToolTip="点这里后直接按组合键；Esc 清除"
                                                                 PreviewKeyDown="CardHotkeyPreviewKeyDown" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <TextBlock Text="与上方卡片间距" VerticalAlignment="Center"
                                                                       Margin="0,0,8,0" />
                                                            <Slider Width="140" Minimum="0" Maximum="120"
                                                                    Value="{Binding Spacing}"
                                                                    IsEnabled="{Binding SpacingEnabled}" />
                                                            <TextBlock Text="{Binding SpacingText}" Width="28"
                                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                                       Margin="6,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Visibility="{Binding ContentVisibility}">
                                                        <TextBlock Text="内容" Style="{StaticResource Hint}" Margin="0,2,0,6" />
                                                        <TextBox x:Name="ContentBox" Style="{StaticResource CodeBox}" Height="90"
                                                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True" AcceptsTab="False" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <ComboBox x:Name="TokenCombo" Width="270"
                                                                      ItemsSource="{Binding Tokens}"
                                                                      DisplayMemberPath="Display"
                                                                      Tag="{Binding ElementName=ContentBox}"
                                                                      SelectionChanged="InsertTokenClick" />
                                                            <TextBlock Text="选择占位符插入到光标处" Style="{StaticResource Hint}"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- 命令行卡片：工具 / 工作目录 / 返回内容都在卡片自己身上 -->
                                                    <StackPanel Visibility="{Binding CommandVisibility}">
                                                        <TextBlock Text="命令行工具" Style="{StaticResource SectionTitle}" Margin="0,6,0,6" />

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="工具" VerticalAlignment="Center" />
                                                            <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left"
                                                                      SelectedIndex="{Binding ShellIndex}">
                                                                <ComboBoxItem Content="命令提示符（CMD）" />
                                                                <ComboBoxItem Content="Windows PowerShell（PWSH）" />
                                                                <ComboBoxItem Content="PowerShell 7（PWSH7）" />
                                                                <ComboBoxItem Content="自定义" />
                                                            </ComboBox>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="自定义命令" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding CustomShell, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding CustomShellEnabled}"
                                                                     ToolTip="用 {cmd} 代表输入的命令，例如 pwsh.exe -NoProfile -Command {cmd}" />
                                                        </Grid>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="工作目录" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="留空 = 用户主目录" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                                <Button Content="选择…" Click="PickCardWorkDirClick" Tag="{Binding}" />
                                                                <Button Content="默认" Margin="6,0,0,0" Click="ClearCardWorkDirClick" Tag="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="返回内容" VerticalAlignment="Center" />
                                                            <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                                                <CheckBox Content="超长单行截断" IsChecked="{Binding Truncate}"
                                                                          VerticalAlignment="Center" Margin="0,0,14,0" />
                                                                <TextBlock Text="单行保留" VerticalAlignment="Center" />
                                                                <TextBox Width="66" Margin="6,0,6,0" VerticalAlignment="Center"
                                                                         IsEnabled="{Binding MaxLineCharsEnabled}"
                                                                         Text="{Binding MaxLineChars, UpdateSourceTrigger=LostFocus}" />
                                                                <TextBlock Text="字符 · 最多" VerticalAlignment="Center" />
                                                                <TextBox Width="60" Margin="6,0,6,0" VerticalAlignment="Center"
                                                                         Text="{Binding MaxLines, UpdateSourceTrigger=LostFocus}" />
                                                                <TextBlock Text="行 · 超时" VerticalAlignment="Center" />
                                                                <TextBox Width="56" Margin="6,0,6,0" VerticalAlignment="Center"
                                                                         Text="{Binding TimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                                                                <TextBlock Text="秒" VerticalAlignment="Center" />
                                                            </WrapPanel>
                                                        </Grid>

                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="提示符" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding PromptPreview}" Margin="8,0,0,0"
                                                                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- 媒体卡片：文件 / 尺寸 / 播放 -->
                                                    <StackPanel Visibility="{Binding MediaVisibility}">
                                                        <TextBlock Text="媒体文件" Style="{StaticResource SectionTitle}" Margin="0,6,0,6" />

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="文件" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding MediaPath, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="支持的图片：png / jpg / bmp / gif / tif；视频：mp4 / wmv / avi / mkv（取决于系统解码器）" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                                <Button Content="选择…" Click="PickMediaFileClick" Tag="{Binding}" />
                                                                <Button Content="清除" Margin="6,0,0,0" Click="ClearMediaFileClick" Tag="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="缩放" VerticalAlignment="Center" />
                                                            <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                                                <ComboBox Width="130" SelectedIndex="{Binding MediaFitIndex}" Margin="0,0,18,0">
                                                                    <ComboBoxItem Content="完整显示" />
                                                                    <ComboBoxItem Content="裁剪填满" />
                                                                    <ComboBoxItem Content="拉伸填满" />
                                                                    <ComboBoxItem Content="原始大小" />
                                                                </ComboBox>
                                                                <TextBlock Text="宽" VerticalAlignment="Center" />
                                                                <TextBox Width="64" Margin="6,0,6,0" VerticalAlignment="Center"
                                                                         Text="{Binding MediaWidth, UpdateSourceTrigger=LostFocus}"
                                                                         ToolTip="0 = 用媒体原始宽度" />
                                                                <TextBlock Text="高" VerticalAlignment="Center" />
                                                                <TextBox Width="64" Margin="6,0,6,0" VerticalAlignment="Center"
                                                                         Text="{Binding MediaHeight, UpdateSourceTrigger=LostFocus}"
                                                                         ToolTip="0 = 按长宽比自动" />
                                                                <TextBlock Text="不透明度" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                <Slider Width="100" Minimum="0" Maximum="1" Margin="6,0,0,0"
                                                                        Value="{Binding MediaOpacity}" VerticalAlignment="Center" />
                                                            </WrapPanel>
                                                        </Grid>

                                                        <WrapPanel Margin="0,0,0,2">
                                                            <CheckBox Content="循环播放" IsChecked="{Binding MediaLoop}"
                                                                      Margin="0,0,18,0" ToolTip="动图 / 视频播放到结尾后重新开始" />
                                                            <CheckBox Content="自动播放" IsChecked="{Binding MediaAutoplay}" Margin="0,0,18,0" />
                                                            <CheckBox Content="静音" IsChecked="{Binding MediaMuted}" Margin="0,0,18,0" />
                                                            <CheckBox Content="圆角" IsChecked="{Binding MediaRounded}" Margin="0,0,18,0"
                                                                      ToolTip="按「外观」里的圆角大小把媒体的四个角裁圆" />
                                                            <TextBlock Text="速度" VerticalAlignment="Center" />
                                                            <Slider Width="100" Minimum="0.25" Maximum="4" Margin="6,0,6,0"
                                                                    Value="{Binding MediaSpeed}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding MediaSpeedText}" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondary}" />
                                                        </WrapPanel>
                                                        <TextBlock Text="解码器" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />

                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="视频 / 图片" VerticalAlignment="Center" />
                                                            <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                                                      SelectedIndex="{Binding MediaDecoderIndex}"
                                                                      ToolTip="自动：系统放不了的格式（mkv / webm / av1 …）改用 ffmpeg&#x0a;仅 ffmpeg：所有视频都交给 ffmpeg（无声音、固定 1× 速度）">
                                                                <ComboBoxItem Content="自动（系统优先）" />
                                                                <ComboBoxItem Content="仅系统 Media Foundation" />
                                                                <ComboBoxItem Content="仅 ffmpeg" />
                                                            </ComboBox>
                                                            <TextBox Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                                                                     Text="{Binding MediaDecoderPath, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="自定义 ffmpeg.exe 的完整路径；留空 = 自动在 PATH 与常见安装目录里找" />
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                                <Button Content="选择…" Click="PickDecoderClick" Tag="{Binding}" />
                                                                <Button Content="检测" Margin="6,0,0,0" Click="DetectDecodersClick" Tag="{Binding}"
                                                                        ToolTip="重新扫描 PATH，看看有哪些解码器" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Text="{Binding DecoderHint}" Margin="0,0,0,2"
                                                                   FontSize="12" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   ToolTip="{Binding DecoderHint}" />

                                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                   Text="自动模式下，系统解不开的视频或图片会改用 ffmpeg；ffmpeg 解码没有声音、速度固定 1×，其余格式与系统解码一致。" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyHint" Text="没有匹配的卡片" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== 外观 ==================== -->
            <TabItem Header="外观" Tag="&#xE301;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16,18,24">

                        <TextBlock Text="文字" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字体" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="FontCombo" Width="300" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontFamily="{Binding Family}" FontSize="14" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="筛选" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#6B7280" />
                                <TextBox x:Name="FontFilterBox" Width="120"
                                         ToolTip="输入关键字筛选字体，例如：雅黑 / Sim / Kai" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字号" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="FontSizeSlider" Width="260" Minimum="8" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="False" />
                                <TextBox x:Name="FontSizeValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="BoldCheck" Content="加粗" Margin="110,0,0,12" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图标字号" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="IconScaleSlider" Width="260" Minimum="0.6" Maximum="2.2" />
                                <TextBox x:Name="IconScaleValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                                <TextBlock Text="× 正文字号（图标字形本身偏小，1.45 ≈ 与文字视觉等高）"
                                           Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="330" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="对齐" VerticalAlignment="Center" />
                            <ComboBox x:Name="AlignCombo" Grid.Column="1" Width="160" HorizontalAlignment="Left">
                                <ComboBoxItem Content="左对齐" Tag="Left" />
                                <ComboBoxItem Content="居中" Tag="Center" />
                                <ComboBoxItem Content="右对齐" Tag="Right" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内边距" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="PaddingSlider" Width="260" Minimum="2" Maximum="40" />
                                <TextBox x:Name="PaddingValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="行高" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="LineHeightSlider" Width="260" Minimum="0" Maximum="60" />
                                <TextBox x:Name="LineHeightValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="OutlineCheck" Content="文字描边（亮色 / 花哨背景上也能看清）" Margin="110,4,0,8" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="描边颜色" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="OutlineColorBox" Width="110" />
                                <Border x:Name="OutlineSwatch" Width="26" Height="26" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Margin="8,0,8,0" />
                                <Button Content="选择…" Click="PickOutlineColorClick" />
                                <TextBlock Text="粗细" VerticalAlignment="Center" Margin="18,0,8,0" />
                                <Slider x:Name="OutlineSlider" Width="120" Minimum="0.4" Maximum="6" />
                                <TextBox x:Name="OutlineValue" Width="58" Margin="8,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="背景" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="前景色" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="FgBox" Width="110" />
                                <Border x:Name="FgSwatch" Width="26" Height="26" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Margin="8,0,8,0" />
                                <Button Content="选择…" Click="PickForegroundClick" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景色" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="BgBox" Width="110" />
                                <Border x:Name="BgSwatch" Width="26" Height="26" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Margin="8,0,8,0" />
                                <Button Content="选择…" Click="PickBackgroundClick" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景不透明度" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="BgOpacitySlider" Width="260" Minimum="0" Maximum="1" />
                                <TextBox x:Name="BgOpacityValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景图片" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ImagePathBox" Width="320" />
                                    <Button Content="选择…" Margin="8,0,0,0" Click="PickBackgroundImageClick" />
                                    <Button Content="清除" Margin="8,0,0,0" Click="ClearBackgroundImageClick" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="拉伸" VerticalAlignment="Center" />
                                    <ComboBox x:Name="StretchCombo" Width="150" Margin="8,0,18,0">
                                        <ComboBoxItem Content="裁剪填满" Tag="UniformToFill" />
                                        <ComboBoxItem Content="完整显示" Tag="Uniform" />
                                        <ComboBoxItem Content="拉伸填满" Tag="Fill" />
                                        <ComboBoxItem Content="原始大小" Tag="None" />
                                    </ComboBox>
                                    <TextBlock Text="不透明度" VerticalAlignment="Center" />
                                    <Slider x:Name="ImageOpacitySlider" Width="130" Minimum="0" Maximum="1" Margin="8,0,0,0" />
                                    <TextBox x:Name="ImageOpacityValue" Width="58" Margin="8,0,0,0" TextAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="圆角" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="CornerSlider" Width="260" Minimum="0" Maximum="30" />
                                <TextBox x:Name="CornerValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ShadowCheck" Content="显示投影" Margin="110,4,0,0" />

                        <TextBlock Text="高级（实验性）" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />

                        <CheckBox x:Name="AcrylicCheck" Content="毛玻璃背景" Margin="0,0,0,4" />
                        <TextBlock x:Name="AcrylicHint" FontSize="12" Foreground="#6B7280" Margin="0,0,0,10"
                                   Text="抓取卡片后面的桌面并模糊，当作卡片底色；把「背景不透明度」调到 0.5 左右更容易看出效果。"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模糊强度" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="AcrylicBlurSlider" Width="260" Minimum="0" Maximum="40" />
                                <TextBox x:Name="AcrylicBlurValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="刷新帧率" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="AcrylicFpsSlider" Width="260" Minimum="2" Maximum="30" />
                                <TextBox x:Name="AcrylicFpsValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                                <TextBlock Text="帧/秒" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="110,0,0,0"
                                   Text="每秒抓几次桌面：15 帧几乎看不出延迟，30 帧更跟手；桌面静止时可调到 8 帧省电。" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 数据源 ==================== -->
            <TabItem Header="数据源" Tag="&#xE302;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16,18,24">

                        <TextBlock Text="设备数据" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox x:Name="CpuCheck" Content="CPU" Margin="0,0,24,10" />
                            <CheckBox x:Name="GpuCheck" Content="GPU" Margin="0,0,24,10" />
                            <CheckBox x:Name="MemCheck" Content="内存" Margin="0,0,24,10" />
                            <CheckBox x:Name="DiskCheck" Content="磁盘" Margin="0,0,24,10" />
                            <CheckBox x:Name="NetCheck" Content="网络" Margin="0,0,24,10" />
                        </WrapPanel>

                        <TextBlock Text="GPU 选择" Style="{StaticResource SectionTitle}" Margin="0,10,0,6" />
                        <ComboBox x:Name="GpuCombo" Width="260" HorizontalAlignment="Left" />

                        <TextBlock Text="磁盘分区（用于剩余空间）" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                        <WrapPanel x:Name="DrivesPanel" />

                        <TextBlock Text="网卡" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="AdapterCombo" Width="380" />
                            <Button Content="刷新" Margin="8,0,0,0" Click="RefreshAdaptersClick" />
                        </StackPanel>

                        <TextBlock Text="键盘输入" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                        <CheckBox x:Name="KeysCheck" Content="记录按键" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="显示最近" VerticalAlignment="Center" />
                            <TextBox x:Name="KeyCountBox" Width="60" Margin="8,0,8,0" />
                            <TextBlock Text="个按键      连续重复超过" VerticalAlignment="Center" />
                            <TextBox x:Name="RepeatBox" Width="60" Margin="8,0,8,0" />
                            <TextBlock Text="次折叠为 字符×次数" VerticalAlignment="Center" />
                            <Button Content="清空记录" Margin="16,0,0,0" Click="ClearKeysClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="最多显示" VerticalAlignment="Center" />
                            <TextBox x:Name="MaxKeyCharsBox" Width="60" Margin="8,0,8,0" />
                            <TextBlock Text="个字符（空格和分隔符也计入，默认 18）" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="NVIDIA 显卡（温度 / 显存 / 功耗）" Style="{StaticResource SectionTitle}" Margin="0,14,0,6" />
                        <CheckBox x:Name="NvidiaCheck" Content="启用 nvidia-smi 数据" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="采样间隔" VerticalAlignment="Center" />
                            <ComboBox x:Name="NvidiaIntervalCombo" Width="120" Margin="8,0,0,0" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 行为 ==================== -->
            <TabItem Header="行为" Tag="&#xE303;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16,18,24">

                        <TextBlock Text="刷新" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="采样间隔" VerticalAlignment="Center" />
                            <ComboBox x:Name="RefreshCombo" Width="140" Margin="8,0,0,0" />
                            <TextBlock Text="间隔越短越流畅，CPU 占用略高" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="窗口" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <CheckBox x:Name="TopmostCheck" Content="始终置顶" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="叠层能否拖动只由 F8（或托盘菜单的「锁定 / 解锁」）切换，打开或关闭本窗口都不会自动解锁、锁定。" />

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="锚点" VerticalAlignment="Center" />
                            <ComboBox x:Name="MonitorCombo" Width="180" Margin="8,0,16,0" />
                            <TextBlock Text="X" VerticalAlignment="Center" />
                            <TextBox x:Name="XBox" Width="70" Margin="8,0,16,0" />
                            <TextBlock Text="Y" VerticalAlignment="Center" />
                            <TextBox x:Name="YBox" Width="70" Margin="8,0,16,0" />
                            <Button Content="应用位置" Click="ApplyPositionClick" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="第一张卡片对齐到锚点，其余卡片按每张的「与上方卡片间距」向下排列；解锁后拖动任意卡片会移动整叠，松手即保存。" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="固定宽度" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="FixedWidthSlider" Width="260" Minimum="0" Maximum="1600" />
                                <TextBox x:Name="FixedWidthValue" Width="58" Margin="10,0,0,0" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="110,2,0,0" TextWrapping="Wrap"
                                   Text="0 = 自适应：宽度只增不减，数据变长只长大一次，之后不再缩回，信息位置不会来回跳动。填入具体数值可完全固定（所有卡片统一）。" />

                        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,0,0,8" />
                        <CheckBox x:Name="StartMinCheck" Content="启动后最小化到托盘" Margin="0,0,0,8" />
                        <CheckBox x:Name="TrayCheck" Content="显示托盘图标" Margin="0,0,0,8" />

                        <TextBlock Text="启动动画" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <CheckBox x:Name="IntroCheck" Content="启动时播放打字 / 退格动画" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="欢迎语" VerticalAlignment="Center" />
                            <TextBox x:Name="WelcomeBox" Width="220" Margin="8,0,16,0" />
                            <TextBlock Text="速度(ms/字)" VerticalAlignment="Center" />
                            <TextBox x:Name="TypeSpeedBox" Width="64" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="光标样式" VerticalAlignment="Center" />
                            <ComboBox x:Name="CursorStyleCombo" Width="140" Margin="8,0,20,0">
                                <ComboBoxItem Content="不显示" Tag="None" />
                                <ComboBoxItem Content="方块" Tag="Block" />
                                <ComboBoxItem Content="竖线" Tag="Bar" />
                                <ComboBoxItem Content="下划线" Tag="Underline" />
                                <ComboBoxItem Content="空心框" Tag="Outline" />
                            </ComboBox>
                            <CheckBox x:Name="CursorBlinkCheck" Content="光标闪烁" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="打字 / 退格时会显示模拟光标，全部信息显示完成后光标自动消失。启动动画只播放第一张可见卡片。" />

                        <TextBlock Text="文件" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="配置文件：" VerticalAlignment="Center" />
                            <TextBlock x:Name="PathText" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="打开配置目录" Click="OpenConfigFolderClick" Margin="0,0,8,0" />
                            <Button Content="打开日志" Click="OpenLogClick" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== 热键 ==================== -->
            <TabItem Header="热键" Tag="&#xE304;">
                <StackPanel Margin="18,16,18,24">
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="点击输入框后直接按下组合键即可修改；Esc 清除，留空表示不启用。每张卡片自己的「呼出热键」在「内容」页设置；两张卡片可以设成同一个组合键，按下时会同时呼出。" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="显示 / 隐藏全部" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox x:Name="HotkeyToggleBox" Grid.Column="1" IsReadOnly="True"
                                 PreviewKeyDown="HotkeyBoxPreviewKeyDown" Margin="0,0,0,10" />

                        <TextBlock Text="打开设置" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,10" />
                        <TextBox x:Name="HotkeySettingsBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                 PreviewKeyDown="HotkeyBoxPreviewKeyDown" Margin="0,0,0,10" />

                        <TextBlock Text="锁定 / 解锁" Grid.Row="2" VerticalAlignment="Center" />
                        <TextBox x:Name="HotkeyLockBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True"
                                 PreviewKeyDown="HotkeyBoxPreviewKeyDown" />
                    </Grid>

                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,16,0,0"
                               Text="留空 = 不启用该热键。热键被其它程序占用时，程序会自动退到 Ctrl+Alt+原键 并记入日志。" />
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- ==================== 底栏 ==================== -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="恢复默认" Margin="0,0,8,0" Click="ResetClick" />
                    <Button Content="关闭" Margin="0,0,8,0" Click="CloseClick" />
                    <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="SaveClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
