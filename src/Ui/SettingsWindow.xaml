<Window x:Class="MirrorpondHUD.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="镜潭一览 · 设置" Width="1120" Height="820" MinWidth="1000" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="/assets/MirrorpondHUDLogoYellow.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="22" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="46">
                            <Border x:Name="Fill" Background="{DynamicResource Accent}" Opacity="0.78"
                                    CornerRadius="7" Margin="14,3,18,3" Visibility="Collapsed" />
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="7"
                                    Margin="14,3,18,3" Padding="14,0,10,0">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="24" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Margin="14,0,0,0"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#1D1D1D" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="Transparent" />
                                <Setter TargetName="Fill" Property="Opacity" Value="0.88" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCircleButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource PressedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" Background="Transparent">
    <Border x:Name="WindowFrame" Margin="0" Background="{DynamicResource WindowBg}"
            BorderThickness="0" CornerRadius="22">
    <AdornerDecorator>
    <Grid x:Name="FrameContent" SizeChanged="FrameContentSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：品牌 / 导航 / 明暗切换 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="24,26,18,0" Background="Transparent"
                        MouseLeftButtonDown="TitleBarMouseDown">
                <Image x:Name="BrandLogo" Source="/assets/MirrorpondHUDLogoDeepYellow.png" Width="58" Height="58"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Mirrorpond" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="HUD" FontSize="22" FontWeight="Bold" Margin="0,-2,0,0"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock x:Name="VersionText" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0" />
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="NavList" Grid.Row="1" Margin="0,34,0,0"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource SettingsNavItem}"
                     SelectionChanged="NavSelectionChanged">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE0FF;" FontFamily="{StaticResource LucideFont}"
                                   Style="{x:Null}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="内容" Style="{x:Null}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE1DD;" FontFamily="{StaticResource LucideFont}"
                                   Style="{x:Null}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="外观" Style="{x:Null}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE0AD;" FontFamily="{StaticResource LucideFont}"
                                   Style="{x:Null}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="数据源" Style="{x:Null}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE29A;" FontFamily="{StaticResource LucideFont}"
                                   Style="{x:Null}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="行为" Style="{x:Null}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE284;" FontFamily="{StaticResource LucideFont}"
                                   Style="{x:Null}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="热键" Style="{x:Null}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <Button x:Name="SettingsThemeToggle" Grid.Row="2" Margin="18,0,18,22" Width="166"
                    HorizontalAlignment="Left" Padding="14,10" Click="ToggleSettingsThemeClick"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}"
                    ToolTip="切换明暗">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ThemeIcon" Text="&#xE11E;" FontFamily="{StaticResource LucideFont}"
                               Style="{x:Null}" FontSize="15" Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ThemeModeText" Text="暗黑模式" Style="{x:Null}" FontSize="13"
                               Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 分隔线不触顶底 -->
        <Border Grid.ColumnSpan="2" Width="2" HorizontalAlignment="Left" Margin="220,64,0,64"
                Panel.ZIndex="10" Background="#737373" />

        <!-- 右栏：内容 + 自绘窗口按钮 + 悬浮操作区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,22,24,0">
                <Button Style="{StaticResource WindowCircleButton}" Click="TitleBarMinimizeClick" ToolTip="最小化"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE11C;" FontFamily="{StaticResource LucideFont}"
                               Style="{x:Null}" FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                </Button>
                <Button Style="{StaticResource WindowCircleButton}" Click="TitleBarCloseClick" ToolTip="退出"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE1B2;" FontFamily="{StaticResource LucideFont}"
                               Style="{x:Null}" FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                </Button>
            </StackPanel>

            <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,0,12,72"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        SelectionChanged="TabSelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>


            <!-- ==================== 内容（卡片管理） ==================== -->
            <TabItem Header="内容" Tag="&#xE0FF;">
                <Grid Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- P-9：插件加载失败的可见入口（设置页顶部横幅）。 -->
                    <Border x:Name="PluginErrorBanner" Grid.Row="0" Visibility="Collapsed"
                            Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource Danger}"
                            BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE1C4;" FontFamily="{StaticResource LucideFont}"
                                       Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                            <TextBlock x:Name="PluginErrorText" Margin="8,0,0,0" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddCardButton" Click="AddCardClick" Padding="12,6"
                                    ToolTip="选择一种卡片添加到列表末尾">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE13D;" FontFamily="{StaticResource LucideFont}" FontSize="15"
                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="添加卡片" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="&#xE151;" FontFamily="{StaticResource LucideFont}" FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBox x:Name="SearchBox" Width="200" TextChanged="SearchBoxTextChanged"
                                     ToolTip="按卡片名称 / 类型筛选" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <ItemsControl x:Name="CardList"
                                          AllowDrop="True"
                                          DragOver="CardListDragOver"
                                          DragLeave="CardListDragLeave"
                                          Drop="CardListDrop">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBg}"
                                                BorderBrush="{DynamicResource BorderSoft}"
                                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <!-- 标题栏：图标 + 名称 + 常驻/热键摘要；右侧移动 / 删除 / 展开 -->
                                                <Border x:Name="CardHeader" Tag="CardHeader" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="0,0,0,1"
                                                        CornerRadius="{Binding HeaderCorner}" Padding="12,7"
                                                        MouseLeftButtonDown="CardHeaderClick">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE0EB;"
                                                                       FontFamily="{StaticResource LucideFont}"
                                                                       FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                                                       Margin="0,0,7,0" VerticalAlignment="Center"
                                                                       Cursor="SizeNS" ToolTip="按住左侧六点拖动排序"
                                                                       Tag="{Binding}"
                                                                       PreviewMouseLeftButtonDown="CardDragHandleDown"
                                                                       PreviewMouseMove="CardDragHandleMove"
                                                                       PreviewMouseLeftButtonUp="CardDragHandleUp" />
                                                            <TextBlock Text="{Binding Icon}"
                                                                       FontFamily="{StaticResource LucideFont}"
                                                                       FontSize="16" Foreground="{DynamicResource Accent}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                            <Border Background="{DynamicResource BadgeBg}" CornerRadius="9" Padding="8,1"
                                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondary}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                                    Click="DuplicateCardClick" ToolTip="复制这张卡片">
                                                                <TextBlock Text="&#xE09E;"
                                                                           FontFamily="{StaticResource LucideFont}"
                                                                           FontSize="14" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                                    Click="MoveCardClick" ToolTip="调整显示顺序">
                                                                <TextBlock Text="&#xE0EB;"
                                                                           FontFamily="{StaticResource LucideFont}"
                                                                           FontSize="14" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                                    Click="DeleteCardClick" ToolTip="删除这张卡片">
                                                                <TextBlock Text="&#xE18E;"
                                                                           FontFamily="{StaticResource LucideFont}"
                                                                           FontSize="14" />
                                                            </Button>
                                                            <Button Style="{StaticResource IconButton}" Tag="{Binding}"
                                                                    Click="ToggleCardClick" ToolTip="展开 / 折叠">
                                                                <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource TextSecondary}"
                                                                      StrokeThickness="1.6" VerticalAlignment="Center">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform Angle="{Binding ChevronAngle}"
                                                                                         CenterX="5" CenterY="3" />
                                                                    </Path.RenderTransform>
                                                                </Path>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 设置项 -->
                                                <StackPanel Visibility="{Binding BodyVisibility}" Margin="14,10,14,14">
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="名称" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Margin="0,0,20,0"
                                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <CheckBox Grid.Column="2" Content="常驻"
                                                                  IsChecked="{Binding Resident}"
                                                                  IsEnabled="{Binding ResidentEnabled}"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="常驻：叠层显示时一直在屏幕上；关闭后需要用呼出热键打开" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="呼出热键" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <TextBox Width="150" HorizontalAlignment="Left"
                                                                     Text="{Binding Hotkey, Mode=OneWay}"
                                                                     IsReadOnly="True"
                                                                     IsEnabled="{Binding HotkeyEnabled}"
                                                                     ToolTip="点这里后直接按组合键；Esc 或「清空」清除"
                                                                     PreviewKeyDown="CardHotkeyPreviewKeyDown" />
                                                            <Button Content="清空" Margin="8,0,0,0" Padding="10,2"
                                                                    VerticalAlignment="Center" Click="ClearCardHotkeyClick"
                                                                    ToolTip="清除这张卡片的呼出热键" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <TextBlock Text="与上方卡片间距" VerticalAlignment="Center"
                                                                       Margin="0,0,8,0" />
                                                            <Slider Width="140" Minimum="0" Maximum="120"
                                                                    Value="{Binding Spacing}"
                                                                    IsEnabled="{Binding SpacingEnabled}" />
                                                            <TextBlock Text="{Binding SpacingText}" Width="28"
                                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                                       Margin="6,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Visibility="{Binding PresetVisibility}" Orientation="Horizontal" Margin="0,4,0,8">
                                                        <TextBlock Text="预设" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <ComboBox Width="200"
                                                                  ItemsSource="{Binding PresetItems}"
                                                                  SelectedIndex="{Binding PresetIndex}" />
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding ContentVisibility}">
                                                        <TextBlock Text="内容" Style="{StaticResource Hint}" Margin="0,2,0,6" />
                                                        <TextBox x:Name="ContentBox" Style="{StaticResource CodeBox}" Height="90"
                                                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True" AcceptsTab="False" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <ComboBox x:Name="TokenCombo" Width="270"
                                                                      ItemsSource="{Binding Tokens}"
                                                                      DisplayMemberPath="Display"
                                                                      Tag="{Binding ElementName=ContentBox}"
                                                                      SelectionChanged="InsertTokenClick" />
                                                            <TextBlock Text="选择占位符插入到光标处" Style="{StaticResource Hint}"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- 卡片自己的设置（命令行工具等）：由模块提供，宿主只摆位置 -->
                                                    <ContentControl Content="{Binding SettingsSection}"
                                                                    Visibility="{Binding SettingsSectionVisibility}" />

                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyHint" Text="没有匹配的卡片" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== 外观 ==================== -->
            <TabItem Header="外观" Tag="&#xE1DD;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16,18,24">

                        <TextBlock Text="主题" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="选一套内置主题，或导入 .mptheme；只改当前设置副本，点“保存并应用”才生效。"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ComboBox x:Name="ThemeCombo" Width="240"
                                                  SelectionChanged="ThemeSelectionChanged" />
                                        <TextBlock x:Name="ThemeNameText" VerticalAlignment="Center"
                                                   Margin="12,0,0,0" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <TextBlock x:Name="ThemeStatusText" Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="预览底色" VerticalAlignment="Center" />
                                        <TextBox x:Name="ThemePreviewBgBox" Grid.Column="1" Width="92"
                                                 TextChanged="ThemePreviewBgChanged" />
                                        <Border Grid.Column="2" Width="18" Height="18" Margin="8,0,0,0"
                                                CornerRadius="2" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderSoft}"
                                                Background="{DynamicResource PreviewBg}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="选择…" Click="PickThemePreviewBgClick" Padding="9,4" />
                                            <Button Content="重置" Click="ResetThemePreviewBgClick" Padding="9,4" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="导入主题…" Click="ImportThemeClick" Padding="12,5" Margin="0,0,8,0" />
                                        <Button Content="导出当前外观…" Click="ExportThemeClick" Padding="12,5" Margin="0,0,8,0" />
                                        <Button Content="还原默认" Click="ResetThemeClick" Padding="12,5" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource PreviewBg}" CornerRadius="6" Padding="8">
                                    <Image x:Name="ThemePreviewImage" Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="卡片" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="对齐方式" VerticalAlignment="Center" />
                            <ComboBox x:Name="CardAlignCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                      ToolTip="左对齐：所有卡片的左边缘对齐；右对齐：右边缘对齐；自动：整叠卡片在屏幕左半边时左对齐、右半边时右对齐">
                                <ComboBoxItem Content="自动" />
                                <ComboBoxItem Content="左对齐" />
                                <ComboBoxItem Content="右对齐" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="文字" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字体" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="FontCombo" Width="300" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" FontFamily="{Binding Family}" FontSize="14" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="筛选" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{DynamicResource TextSecondary}" />
                                <TextBox x:Name="FontFilterBox" Width="120"
                                         ToolTip="输入关键字筛选字体，例如：雅黑 / Sim / Kai" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字号" VerticalAlignment="Center" />
