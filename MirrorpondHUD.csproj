<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MirrorpondHUD</AssemblyName>
    <RootNamespace>MirrorpondHUD</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\logo.ico</ApplicationIcon>
    <!-- x64 by default; publish -r win-arm64 switches PlatformTarget automatically. -->
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</PlatformTarget>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>2.14.4</Version>
    <Product>镜潭一览 (MirrorpondHUD)</Product>
    <AssemblyTitle>MirrorpondHUD</AssemblyTitle>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml" />
    <Page Remove="src\App.xaml" />
    <!-- sample 插件是独立工程，不编进宿主。 -->
    <Compile Remove="samples\**\*.cs" />
    <Page Remove="samples\**\*.xaml" />
    <None Remove="samples\**\*" />
    <!-- 契约 / DTO 已在独立程序集 MirrorpondHUD.Contracts 里。 -->
    <Compile Remove="src\Contracts\**\*.cs" />
    <Page Remove="src\Contracts\**\*.xaml" />
    <None Remove="src\Contracts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Contracts\MirrorpondHUD.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\logo.ico" />
    <Resource Include="assets\logo-light.ico" />
    <Resource Include="assets\keycaps\ReiconFont-Regular.ttf" />
  </ItemGroup>

  <!-- 内置主题：docs/themes/*.mptheme 编进程序集，发布版不依赖 docs 目录。 -->
  <ItemGroup>
    <EmbeddedResource Include="docs\themes\*.mptheme" />
  </ItemGroup>

</Project>
